    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.2",
    "@types/yargs": "^17.0.35",
    "bun-types": "^1.3.4",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "pretty-quick": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "dependencies": {
